{
    "version": 1,
    "disable_existing_loggers": false,

    "filters": {
        "correlation_id": {
            "()": "asgi_correlation_id.CorrelationIdFilter",
            "default_value": "-"
        }
    },
    "formatters": {
        "web": {
            "format": "%(asctime)s - %(name)s - %(correlation_id)s - %(levelname)s - %(message)s",
            "class": "pythonjsonlogger.jsonlogger.JsonFormatter"
        },
        "default": {
            "class": "app.log.HypercornJSONDefaultFormatter"
        },
        "access": {
            "class": "app.log.HypercornJSONAccessFormatter"
        }
    },
    "handlers": {
        "web": {
            "class": "logging.StreamHandler",
            "formatter": "web",
            "stream": "ext://sys.stdout",
            "filters": ["correlation_id"]
        },
        "default": {
            "formatter": "default",
            "class": "logging.StreamHandler",
            "stream": "ext://sys.stderr",
            "filters": ["correlation_id"]

        },
        "access": {
            "formatter": "access",
            "class": "logging.StreamHandler",
            "stream": "ext://sys.stdout",
            "filters": ["correlation_id"]
        }
    },
    "loggers": {
        "root": {
            "level": "INFO",
            "handlers": [
                "web"
            ]
        },
        "app": {
            "propagate": 0,
            "level": "INFO",
            "handlers": [
                "web"
            ]
        },
        "hypercorn": {"handlers": ["default"], "level": "INFO", "propagate": 0},
        "hypercorn.error":  {"handlers": ["default"], "level": "INFO", "propagate": 0},
        "hypercorn.access": {"handlers": ["access"], "level": "INFO", "propagate": 0}
    }
}
