{
    "version": 1,
    "disable_existing_loggers": false,

    "filters": {
        "correlation_id": {
            "()": "asgi_correlation_id.CorrelationIdFilter",
            "default_value": "-"
        }
    },
    "formatters": {
        "web": {
            "format": "%(asctime)s - %(name)s - %(correlation_id)s - %(levelname)s - %(message)s",
            "class": "pythonjsonlogger.jsonlogger.JsonFormatter"
        },
        "uv_default": {
            "class": "ep_recommender.logging.UvicornJSONDefaultFormatter"
        },
        "uv_access": {
            "class": "ep_recommender.logging.UvicornJSONAccessFormatter"
        }
    },
    "handlers": {
        "web": {
            "class": "logging.StreamHandler",
            "formatter": "web",
            "stream": "ext://sys.stdout",
            "filters": ["correlation_id"]
        },
        "uv_default": {
            "formatter": "uv_default",
            "class": "logging.StreamHandler",
            "stream": "ext://sys.stderr",
            "filters": ["correlation_id"]

        },
        "uv_access": {
            "formatter": "uv_access",
            "class": "logging.StreamHandler",
            "stream": "ext://sys.stdout",
            "filters": ["correlation_id"]
        }
    },
    "loggers": {
        "root": {
            "level": "INFO",
            "handlers": [
                "web"
            ]
        },
        "ep_recommender": {
            "propagate": 0,
            "level": "INFO",
            "handlers": [
                "web"
            ]
        },
        "uvicorn": {"handlers": ["uv_default"], "level": "INFO", "propagate": 0},
        "uvicorn.error":  {"handlers": ["uv_default"], "level": "INFO", "propagate": 0},
        "uvicorn.access": {"handlers": ["uv_access"], "level": "INFO", "propagate": 0}
    }
}
